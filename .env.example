# Server (Express) – local or EC2
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/renova
COGNITO_USER_POOL_ID=us-east-1_xxxxx
COGNITO_REGION=us-east-1

# Email de invitación (SES). En EC2 el role de la instancia debe tener permiso ses:SendEmail.
# SES_FROM_EMAIL debe ser un email o dominio verificado en Amazon SES.
FRONTEND_URL=https://tu-app.ejemplo.com
SES_FROM_EMAIL=notificaciones@tu-dominio.com
# Opcional: región para SES (por defecto usa COGNITO_REGION)
# AWS_REGION=us-east-1

# Imágenes de juegos (S3). En EC2 el role debe tener permisos s3 sobre el bucket.
# Tras deploy CDK, usar el output GameImagesBucketName.
GAMES_IMAGES_BUCKET=nombre-del-bucket
# AWS_REGION=us-east-1

# BGG XML API2 (catálogo / enriquecimiento)
BGG_API_TOKEN=your-bgg-token
BGG_API_USERNAME=renovatuludoteca
# Cron que enriquece el catálogo desde BGG (descripción, etc.). Sin esto el cron no se programa.
# ENABLE_CATALOG_CRON=1
# CRON_ENRICH_CATALOG=*/15 * * * *
